# Copy to .env.local for local run
DATABASE_URL=postgres://cardbook:cardbook@localhost:5432/cardbook
BETTER_AUTH_SECRET=change-me-to-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# ZeptoMail (get from zeptomail.zoho.com → Mail Agents → API keys + verified sender)
ZEPTOMAIL_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
